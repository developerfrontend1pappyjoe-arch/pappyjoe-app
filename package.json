{
  "name": "PappyJoe",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& { . ./scripts/android-build-env.ps1; react-native run-android }\"",
    "clean-linux": "cd android && ./gradlew clean && cd ..",
    "build-linux": "cd android && ./gradlew clean && ./gradlew assembleRelease && cd ..",
    "clean-windows": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& { . ./scripts/android-build-env.ps1; Set-Location android; ./gradlew.bat clean }\"",
    "build-windows": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& { . ./scripts/android-build-env.ps1; Set-Location android; ./gradlew.bat clean; ./gradlew.bat assembleRelease }\"",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "ios-build-pre": "react-native bundle --entry-file index.js --platform ios --dev false --bundle-output ios/main.jsbundle --assets-dest ios",
    "release-linux": "cd android && ./gradlew clean && cd.. && npx react-native build-android --mode=release",
    "release-windows": "cd android && ./gradlew clean && cd.. && npx react-native build-android --mode=release",
    "android:bundle-release": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& { . ./scripts/android-build-env.ps1; Set-Location android; ./gradlew.bat bundleRelease }\"",
    "android:debug-apk": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& { . ./scripts/android-build-env.ps1; Set-Location android; ./gradlew.bat assembleDebug }\"",
    "android:logcat-crash": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/android-logcat-crash.ps1",
    "restart": "yarn start --reset-cache",
    "lint:check": "eslint ./src",
    "lint:fix": "eslint --fix ./src",
    "pretty": "prettier --write ./src/**/*.ts ./src/**/*.tsx"
  },
